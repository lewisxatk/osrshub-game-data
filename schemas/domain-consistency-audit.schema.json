{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub cross-domain consistency audit",
  "type": "object",
  "required": [
    "generated_at",
    "status",
    "datasets",
    "counts",
    "errors",
    "warnings",
    "guardrails"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "review_required",
        "failed"
      ]
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "error_count",
        "warning_count"
      ],
      "properties": {
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "quest_prerequisite_edges": {
          "type": "integer",
          "minimum": 0
        },
        "item_relationship_rows": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
