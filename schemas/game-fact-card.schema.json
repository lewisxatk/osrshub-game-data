{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub database fact card",
  "type": "object",
  "required": ["generated_at", "status", "dataset", "record", "fact_count", "known_fields", "unknown_fields", "provenance", "guardrails"],
  "properties": {
    "generated_at": {"type": "string"},
    "status": {"enum": ["found", "not_found"]},
    "dataset": {"type": "string"},
    "record": {"type": ["object", "null"]},
    "fact_count": {"type": "integer", "minimum": 0},
    "known_fields": {"type": "array", "items": {"type": "string"}},
    "unknown_fields": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "required": ["source_urls", "source_fields_present", "has_source_url"], "properties": {
      "source_urls": {"type": "array"},
      "source_fields_present": {"type": "array", "items": {"type": "string"}},
      "has_source_url": {"type": "boolean"},
      "warning": {"type": "string"}
    }},
    "guardrails": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
