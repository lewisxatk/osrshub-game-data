{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub database record quality audit",
  "type": "object",
  "required": [
    "generated_at",
    "status",
    "dataset_count",
    "total_record_rows",
    "issue_count",
    "unreadable_file_count",
    "unreadable_files",
    "datasets",
    "interpretation",
    "guardrails"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "review_required",
        "failed"
      ]
    },
    "dataset_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_record_rows": {
      "type": "integer",
      "minimum": 0
    },
    "issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "unreadable_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "unreadable_files": {
      "type": "array"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "record_count",
          "identity_field",
          "unique_identity_count",
          "duplicate_identity_count",
          "missing_identity_count",
          "invalid_identity_count",
          "blank_name_count",
          "invalid_numeric_value_count",
          "issue_count",
          "issues"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "identity_field": {
            "type": "string"
          },
          "unique_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "invalid_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "blank_name_count": {
            "type": "integer",
            "minimum": 0
          },
          "invalid_numeric_value_count": {
            "type": "integer",
            "minimum": 0
          },
          "issue_count": {
            "type": "integer",
            "minimum": 0
          },
          "issues": {
            "type": "array"
          }
        }
      }
    },
    "interpretation": {
      "type": "string"
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
