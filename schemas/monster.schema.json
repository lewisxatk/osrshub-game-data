{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub normalized monster record",
  "type": "object",
  "required": [
    "id",
    "name",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "hitpoints": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "combat_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "attack_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "strength_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "defence_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "magic_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ranged_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_records": {
      "type": "object"
    }
  }
}
