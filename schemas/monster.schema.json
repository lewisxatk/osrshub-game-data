{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub compact merged monster record",
  "type": "object",
  "required": ["id", "name", "sources"],
  "properties": {
    "id": {"type": "integer", "minimum": 0},
    "name": {"type": "string"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hitpoints": {"type": ["integer", "null"], "minimum": 0},
    "combat_level": {"type": ["integer", "null"], "minimum": 0},
    "attack_level": {"type": ["integer", "null"], "minimum": 0},
    "strength_level": {"type": ["integer", "null"], "minimum": 0},
    "defence_level": {"type": ["integer", "null"], "minimum": 0},
    "magic_level": {"type": ["integer", "null"], "minimum": 0},
    "ranged_level": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": true
}
