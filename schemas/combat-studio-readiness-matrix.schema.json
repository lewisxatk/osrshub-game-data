{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Combat Studio Readiness Matrix","type":"object",
 "required":["generated_at","schema_version","status","interpretation","dataset_count","available_dataset_count","datasets","relationships","priority_gap_count","priority_gaps","input_errors","guardrails"],
