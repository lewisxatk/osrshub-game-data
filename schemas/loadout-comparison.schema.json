{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline loadout comparison",
  "type": "object",
  "required": [
    "status",
    "current",
    "candidate",
    "delta",
    "comparability",
    "warnings"
  ],
  "properties": {
    "status": {
      "const": "baseline_comparison_only"
    },
    "current": {
      "type": "object"
    },
    "candidate": {
      "type": "object"
    },
    "delta": {
      "type": "object"
    },
    "comparability": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
