{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combat Studio upgrade plan",
  "type": "object",
  "required": ["generated_at", "schema_version", "status", "attack_style", "upgrade_budget_gp", "baseline", "recommendations", "search", "candidate_counts", "non_improving_candidates_excluded", "eligibility_audit", "warnings", "guardrails"],
  "properties": {
    "generated_at": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["upgrade_recommendations_with_limitations", "no_improving_upgrade_found"]},
    "attack_style": {"enum": ["stab", "slash", "crush"]},
    "upgrade_budget_gp": {"type": "integer", "minimum": 0},
    "baseline": {
      "type": "object",
      "required": ["item_ids", "total_cost_gp", "dps", "hit_chance", "max_hit", "weapon"],
      "properties": {
        "item_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "total_cost_gp": {"const": 0},
        "dps": {"type": "number"},
        "hit_chance": {"type": "number"},
        "max_hit": {"type": "integer"},
        "weapon": {"type": "object"}
      },
      "additionalProperties": true
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "upgrade_cost_gp", "remaining_budget_gp", "baseline_dps", "candidate_dps", "dps_gain", "dps_gain_percent", "dps_gain_per_million_gp", "weapon", "slot_changes", "selected_items", "combat_comparison", "warnings"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "upgrade_cost_gp": {"type": "integer", "minimum": 0},
          "remaining_budget_gp": {"type": "integer", "minimum": 0},
          "baseline_dps": {"type": "number"},
          "candidate_dps": {"type": "number"},
          "dps_gain": {"type": "number"},
          "dps_gain_percent": {"type": ["number", "null"]},
          "dps_gain_per_million_gp": {"type": ["number", "null"]},
          "weapon": {"type": ["object", "null"]},
          "slot_changes": {"type": "array", "items": {"type": "object"}},
          "selected_items": {"type": "array", "items": {"type": "object"}},
          "combat_comparison": {"type": "object", "required": ["baseline", "candidate", "delta"], "properties": {"baseline": {"$ref": "#/$defs/combat_metrics"}, "candidate": {"$ref": "#/$defs/combat_metrics"}, "delta": {"type": "object", "required": ["attack_roll", "defence_roll", "hit_chance", "max_hit", "expected_damage_per_attack", "attack_speed_ticks", "dps"], "properties": {"attack_roll": {"type": "integer"}, "defence_roll": {"type": "integer"}, "hit_chance": {"type": "number"}, "max_hit": {"type": "integer"}, "expected_damage_per_attack": {"type": "number"}, "attack_speed_ticks": {"type": "integer"}, "dps": {"type": "number"}}}}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "search": {"type": "object"},
    "candidate_counts": {"type": "object"},
    "non_improving_candidates_excluded": {"type": "integer", "minimum": 0},
    "eligibility_audit": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "guardrails": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"combat_metrics": {"type": "object", "required": ["attack_roll", "defence_roll", "hit_chance", "max_hit", "expected_damage_per_attack", "attack_speed_ticks", "dps"], "properties": {"attack_roll": {"type": "integer", "minimum": 0}, "defence_roll": {"type": "integer", "minimum": 0}, "hit_chance": {"type": "number", "minimum": 0, "maximum": 1}, "max_hit": {"type": "integer", "minimum": 0}, "expected_damage_per_attack": {"type": "number", "minimum": 0}, "attack_speed_ticks": {"type": "integer", "minimum": 1}, "dps": {"type": "number", "minimum": 0}}, "additionalProperties": true}},
  "additionalProperties": true
}
