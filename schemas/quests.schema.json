{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub quest record",
  "type": "object",
  "required": ["key", "name", "requirements", "skill_requirements", "rewards", "members", "difficulty", "quest_type", "source_url", "source_fields"],
  "properties": {
    "key": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "skill_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "level"],
        "properties": {"skill": {"type": "string", "minLength": 1}, "level": {"type": "integer", "minimum": 0}},
        "additionalProperties": false
      }
    },
    "rewards": {"type": "array", "items": {"type": "string"}},
    "members": {"type": ["boolean", "null"]},
    "difficulty": {"type": ["string", "null"]},
    "quest_type": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"], "pattern": "^https://"},
    "source_fields": {"type": "array", "items": {"type": "string"}},
    "requirement_evidence": {
      "type": ["object", "null"],
      "required": ["requirements_text", "requirement_links", "source_url", "evidence_status"],
      "properties": {
        "requirements_text": {"type": "string"},
        "requirement_links": {"type": "array", "items": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https://oldschool\\.runescape\\.wiki/"}}, "additionalProperties": false}},
        "source_url": {"type": "string", "pattern": "^https://oldschool\\.runescape\\.wiki/"},
        "evidence_status": {"const": "raw_source_extracted_needs_structured_review"}
      },
      "additionalProperties": false
    },
    "field_status": {
      "type": "object",
      "properties": {
        "requirements": {"enum": ["known", "unknown"]},
        "skill_requirements": {"enum": ["known", "unknown"]},
        "rewards": {"enum": ["known", "unknown"]},
        "members": {"enum": ["known", "unknown"]},
        "difficulty": {"enum": ["known", "unknown"]},
        "quest_type": {"enum": ["known", "unknown"]}
      },
      "required": ["requirements", "skill_requirements", "rewards", "members", "difficulty", "quest_type"],
      "additionalProperties": false
    },
    "field_sources": {
      "type": "object",
      "properties": {
        "requirements": {"type": "string", "pattern": "^https://"},
        "skill_requirements": {"type": "string", "pattern": "^https://"},
        "rewards": {"type": "string", "pattern": "^https://"},
        "members": {"type": "string", "pattern": "^https://"},
        "difficulty": {"type": "string", "pattern": "^https://"},
        "quest_type": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
