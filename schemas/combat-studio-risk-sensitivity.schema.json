{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub Combat Studio risk sensitivity analysis",
  "type": "object",
  "required": [
    "generated_at",
    "schema_version",
    "status",
    "attack_style",
    "budget_gp",
    "scenario_count",
    "source_candidate_count",
    "risk_step_percent",
    "risk_profile_count",
    "top_n",
    "winner_change_count",
    "profiles",
    "winner_stability",
    "interpretation",
    "guardrails"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string"
    },
    "attack_style": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget_gp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scenario_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "risk_step_percent": {
      "enum": [
        5,
        10,
        20,
        25,
        50,
        100
      ]
    },
    "risk_profile_count": {
      "type": "integer",
      "minimum": 2
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "winner_change_count": {
      "type": "integer",
      "minimum": 0
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "risk_aversion",
          "winner_item_ids",
          "winner_score",
          "top_candidates"
        ],
        "properties": {
          "risk_aversion": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "winner_item_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "winner_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "top_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "selected_item_ids",
                "total_cost_gp",
                "weighted_average_dps",
                "worst_case_dps",
                "best_case_dps",
                "dps_spread",
                "risk_adjusted_dps",
                "risk_aversion"
              ],
              "properties": {
                "selected_item_ids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "total_cost_gp": {
                  "type": "integer",
                  "minimum": 0
                },
                "weighted_average_dps": {
                  "type": "number",
                  "minimum": 0
                },
                "worst_case_dps": {
                  "type": "number",
                  "minimum": 0
                },
                "best_case_dps": {
                  "type": "number",
                  "minimum": 0
                },
                "dps_spread": {
                  "type": "number",
                  "minimum": 0
                },
                "risk_adjusted_dps": {
                  "type": "number",
                  "minimum": 0
                },
                "risk_aversion": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "winner_stability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "selected_item_ids",
          "first_place_profiles",
          "profile_count",
          "first_place_share"
        ],
        "properties": {
          "selected_item_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "first_place_profiles": {
            "type": "integer",
            "minimum": 0
          },
          "profile_count": {
            "type": "integer",
            "minimum": 1
          },
          "first_place_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "interpretation": {
      "type": "object",
      "required": [
        "risk_aversion_0",
        "risk_aversion_1",
        "winner_change_count",
        "first_place_share"
      ],
      "properties": {
        "risk_aversion_0": {
          "type": "string"
        },
        "risk_aversion_1": {
          "type": "string"
        },
        "winner_change_count": {
          "type": "string"
        },
        "first_place_share": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
