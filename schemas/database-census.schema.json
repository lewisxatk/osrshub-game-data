{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub generated database census",
  "type": "object",
  "required": [
    "generated_at",
    "status",
    "definition",
    "totals",
    "domains",
    "datasets",
    "guardrails"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "definition": {
      "type": "string"
    },
    "totals": {
      "type": "object",
      "required": [
        "dataset_file_count",
        "record_rows_across_files",
        "object_records_across_files",
        "unique_identity_keys_within_files",
        "total_bytes",
        "files_with_duplicate_identities",
        "files_with_missing_identities",
        "invalid_json_file_count"
      ],
      "properties": {
        "dataset_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "record_rows_across_files": {
          "type": "integer",
          "minimum": 0
        },
        "object_records_across_files": {
          "type": "integer",
          "minimum": 0
        },
        "unique_identity_keys_within_files": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "files_with_duplicate_identities": {
          "type": "integer",
          "minimum": 0
        },
        "files_with_missing_identities": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_json_file_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "dataset_file_count",
          "record_rows_across_files",
          "unique_identity_keys_within_files"
        ]
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "path",
          "domain",
          "status",
          "byte_size",
          "sha256",
          "record_count",
          "identity_field",
          "unique_identity_count",
          "missing_identity_count",
          "invalid_identity_count",
          "duplicate_identity_count",
          "duplicate_identity_samples",
          "fields"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "review_required",
              "invalid_json"
            ]
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "identity_field": {
            "type": [
              "string",
              "null"
            ]
          },
          "unique_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "invalid_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_identity_samples": {
            "type": "array"
          },
          "fields": {
            "type": "object"
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
