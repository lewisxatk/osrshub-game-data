{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://osrshub.local/schemas/quest-evidence-reconciliation.schema.json",
 "title":"Quest Evidence Reconciliation Audit","type":"object",
 "required":["generated_at","schema_version","status","source_url","catalogue_record_count","evidence_record_count","matched_catalogue_record_count","unmatched_evidence_record_count","catalogue_titles_without_matched_evidence","duplicate_normalized_evidence_titles","records_with_non_placeholder_requirement_text","records_with_placeholder_or_empty_requirement_text","trusted_requirement_link_count","source_row_shape_counts","errors","error_count","warnings","warning_count","interpretation_limits"],
 "properties":{
  "generated_at":{"type":"string","format":"date-time"},"schema_version":{"const":"1.0.0"},"status":{"enum":["review_required","failed"]},"source_url":{"type":"string","format":"uri"},
  "catalogue_record_count":{"type":"integer","minimum":0},"evidence_record_count":{"type":"integer","minimum":0},"matched_catalogue_record_count":{"type":"integer","minimum":0},"unmatched_evidence_record_count":{"type":"integer","minimum":0},
  "catalogue_titles_without_matched_evidence":{"type":"array","items":{"type":"string"}},"duplicate_normalized_evidence_titles":{"type":"array","items":{"type":"object"}},
  "records_with_non_placeholder_requirement_text":{"type":"integer","minimum":0},"records_with_placeholder_or_empty_requirement_text":{"type":"integer","minimum":0},"trusted_requirement_link_count":{"type":"integer","minimum":0},
  "source_row_shape_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"errors":{"type":"array","items":{"type":"object"}},"error_count":{"type":"integer","minimum":0},"warnings":{"type":"array","items":{"type":"object"}},"warning_count":{"type":"integer","minimum":0},
  "interpretation_limits":{"type":"array","minItems":1,"items":{"type":"string"}}
 },"additionalProperties":true
}
