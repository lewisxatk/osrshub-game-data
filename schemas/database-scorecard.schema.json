{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSRS Hub database coverage scorecard",
  "type": "object",
  "required": ["status", "coverage_index_percent", "coverage_index_definition", "dataset_count", "total_records_across_datasets", "datasets", "errors", "guardrails"],
  "properties": {
    "generated_at": {"type": "string"},
    "status": {"enum": ["passed", "failed"]},
    "coverage_index_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "coverage_index_definition": {"type": "string"},
    "dataset_count": {"type": "integer", "minimum": 0},
    "total_records_across_datasets": {"type": "integer", "minimum": 0},
    "datasets": {"type": "object", "additionalProperties": {
      "type": "object",
      "required": ["record_count", "field_count", "field_presence_opportunities", "field_presence_count", "field_coverage_percent", "fields"],
      "properties": {
        "path": {"type": "string"},
        "record_count": {"type": "integer", "minimum": 0},
        "field_count": {"type": "integer", "minimum": 0},
        "field_presence_opportunities": {"type": "integer", "minimum": 0},
        "field_presence_count": {"type": "integer", "minimum": 0},
        "field_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "equipment_link_and_source_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "weapon_link_and_speed_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "fields": {"type": "object", "additionalProperties": {
          "type": "object",
          "required": ["present_records", "missing_records", "coverage_percent"],
          "properties": {
            "present_records": {"type": "integer", "minimum": 0},
            "missing_records": {"type": "integer", "minimum": 0},
            "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        }}
      },
      "additionalProperties": true
    }},
    "errors": {"type": "array", "items": {"type": "string"}},
    "guardrails": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
